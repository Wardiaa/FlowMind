# Copy this file to .env for local development.

# PostgreSQL for local development (docker compose up -d db)
DATABASE_URL=postgresql://flowmind:flowmind_local_dev@127.0.0.1:5432/flowmind

# Local sign-in: one development account without a password. Refused when NODE_ENV=production.
FLOWMIND_AUTH_MODE=local
LOCAL_DEV_EMAIL=you@flowmind.local

# Local development uses the filesystem storage adapter.
FLOWMIND_STORAGE_MODE=filesystem
FLOWMIND_DATA_DIR=./data

FLOWMIND_WEB_PORT=22473
API_PORT=8080
PUBLIC_APP_URL=http://127.0.0.1:22473
CORS_ALLOWED_ORIGINS=http://127.0.0.1:22473

GEMINI_API_KEY=

# Chat model for AI features. Defaults to gemini-3.5-flash-lite (largest free quota);
# e.g. gemini-3-flash-preview offers preview-model quality but only ~20 free requests/day.
# GEMINI_CHAT_MODEL=gemini-3-flash-preview

# Soft daily cap on chat AI requests (rolling 24h window). Default 1000. 0 disables the guard.
# GEMINI_DAILY_REQUEST_LIMIT=500

# --- Google OAuth (production sign-in; unused while FLOWMIND_AUTH_MODE=local) ---
# Register a "Web application" OAuth client at https://console.cloud.google.com/apis/credentials
# and add the authorized redirect URI below, which must exactly match
# ${PUBLIC_APP_URL}/api/callback -> e.g. https://flowmind.example.com/api/callback
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- S3-compatible object storage (production; see .env.production.example and NEON_SETUP.md) ---
# FLOWMIND_STORAGE_MODE=s3
# S3_ENDPOINT=https://<branch-id>.storage.<cell>.<region>.aws.neon.tech
# S3_REGION=us-east-2
# S3_BUCKET=flowmind
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
