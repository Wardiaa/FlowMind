# Production deployment. On hosts like Render, set these as environment
# variables in the dashboard; the start script only reads a local
# .env.production file when one exists.

NODE_ENV=production
PORT=8080

# Neon PostgreSQL connection string (see NEON_SETUP.md). Use the pooled
# connection string and keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/flowmind?sslmode=require

# Public HTTPS origin of the app. OIDC redirects are derived from this value.
PUBLIC_APP_URL=https://flowmind.example.com
CORS_ALLOWED_ORIGINS=https://flowmind.example.com

# --- Google OAuth (the only production sign-in method) ---
# 1. Open https://console.cloud.google.com/apis/credentials and create an
#    OAuth client ID of type "Web application".
# 2. Add an authorized redirect URI that exactly matches
#    ${PUBLIC_APP_URL}/api/callback -> https://flowmind.example.com/api/callback
# 3. Copy the client ID and client secret below.
FLOWMIND_AUTH_MODE=oidc
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=1234567890-example.apps.googleusercontent.com
OIDC_CLIENT_SECRET=GOCSPX-example

# --- Neon Object Storage (S3-compatible) ---
# See NEON_SETUP.md for where to find each value in the Neon Console.
FLOWMIND_STORAGE_MODE=s3
S3_ENDPOINT=https://<branch-id>.storage.<cell>.<region>.aws.neon.tech
S3_REGION=us-east-2
S3_BUCKET=flowmind-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Filesystem storage fallback. Do not use on hosts with an ephemeral disk.
# FLOWMIND_STORAGE_MODE=filesystem
# FLOWMIND_ALLOW_FILESYSTEM_STORAGE_IN_PRODUCTION=true
# FLOWMIND_DATA_DIR=/var/lib/flowmind

GEMINI_API_KEY=
